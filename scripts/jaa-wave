#!/usr/bin/env zsh
set -euo pipefail

usage="usage: scripts/jaa-wave [--terminal herdr|warp|manual] <name>:<model>:<effort> [...]"
first_port=8082

terminal=""
if [[ "${1:-}" == --terminal ]]; then
  terminal="${2:-}"
  shift $(( $# < 2 ? $# : 2 ))
fi

if (( $# == 0 )); then
  echo "$usage" >&2
  exit 64
fi

repo="${0:A:h:h}"

names=()
for spec in "$@"; do
  IFS=':' read -r name model effort extra <<< "$spec"
  if [[ -z "${name:-}" || -z "${model:-}" || -z "${effort:-}" || -n "${extra:-}" ]]; then
    echo "bad spec: $spec (expected name:model:effort)" >&2
    exit 64
  fi
  if [[ ! "$name" =~ ^[a-z]+$ ]]; then
    echo "bad name in $spec (one lowercase word, no digits)" >&2
    exit 64
  fi
  if (( ${names[(Ie)$name]} )); then
    echo "duplicate peer name: $name" >&2
    exit 64
  fi
  names+=("$name")
done

if [[ -z "$terminal" ]]; then
  case "${TERM_PROGRAM:-}" in
    herdr) terminal=herdr ;;
    WarpTerminal) terminal=warp ;;
    *) terminal=manual ;;
  esac
fi

session_command() {
  local index="$1" name model effort
  IFS=':' read -r name model effort <<< "$2"
  echo "scripts/jaa-session $name $model $effort $(( first_port + index - 1 )); exit"
}

open_warp() {
  local config_dir="$HOME/.warp/tab_configs"
  local config="$config_dir/jaa-wave.toml"
  local i
  mkdir -p "$config_dir"
  {
    echo 'name = "jaa-wave"'
    echo
    if (( ${#names[@]} > 1 )); then
      echo '[[panes]]'
      echo 'id = "root"'
      echo 'split = "horizontal"'
      printf 'children = [%s]\n' "$(printf '"%s", ' "${names[@]}" | sd ', $' '')"
      echo
    fi
    for (( i = 1; i <= $#; i++ )); do
      echo '[[panes]]'
      echo "id = \"${names[$i]}\""
      echo 'type = "terminal"'
      echo "directory = \"$repo\""
      echo "commands = [\"$(session_command "$i" "${@[$i]}")\"]"
      echo
    done
  } > "$config"
  open "warp://tab_config/jaa-wave"
}

open_herdr() {
  if ! command -v herdr > /dev/null || ! herdr status server > /dev/null 2>&1; then
    echo "herdr is not running: start herdr or pass --terminal warp|manual" >&2
    exit 69
  fi
  local pane
  local workspace=()
  [[ -n "${HERDR_WORKSPACE_ID:-}" ]] && workspace=(--workspace "$HERDR_WORKSPACE_ID")
  pane="$(herdr tab create "${workspace[@]}" --cwd "$repo" --label jaa-wave --no-focus | jq -r '.result.root_pane.pane_id')"
  local panes=("$pane")
  local i
  for (( i = 2; i <= $#; i++ )); do
    pane="$(herdr pane split "$pane" --direction right --ratio "$(( 1.0 / ($# - i + 2) ))" --cwd "$repo" --no-focus | jq -r '.result.pane.pane_id')"
    panes+=("$pane")
  done
  for (( i = 1; i <= $#; i++ )); do
    herdr pane rename "${panes[$i]}" "${names[$i]}" > /dev/null
    herdr pane run "${panes[$i]}" "$(session_command "$i" "${@[$i]}")" > /dev/null
  done
}

print_manual() {
  local i
  echo "Run each line in its own terminal, from $repo:"
  for (( i = 1; i <= $#; i++ )); do
    echo "  $(session_command "$i" "${@[$i]}")"
  done
}

print_ports() {
  local i
  for (( i = 1; i <= ${#names[@]}; i++ )); do
    echo "@${names[$i]} metro $(( first_port + i - 1 ))"
  done
}

case "$terminal" in
  herdr) open_herdr "$@" ;;
  warp) open_warp "$@" ;;
  manual) print_manual "$@" ;;
  *)
    echo "unknown terminal: $terminal (expected herdr, warp or manual)" >&2
    exit 64
    ;;
esac
print_ports
