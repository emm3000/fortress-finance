{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx eslint *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v*)",
      "Bash(git branch --list *)",
      "Bash(git blame *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files)",
      "Bash(git ls-files *)",
      "Bash(git merge-base *)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git remote -v)",
      "Bash(git stash list)",
      "Bash(git stash list *)",
      "Bash(git worktree list)",
      "Bash(git worktree list *)",
      "Bash(git worktree add *)",
      "Bash(git worktree remove *)",
      "Bash(git worktree prune)",
      "Bash(scripts/jaa-wave *)",
      "Bash(scripts/jaa-session *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(rg *)",
      "Bash(fd)",
      "Bash(fd *)",
      "Bash(bat *)",
      "Bash(eza)",
      "Bash(eza *)",
      "Bash(wc *)",
      "Bash(pwd)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push * +main*)",
      "Bash(git push * +*:main*)",
      "Bash(git push * +refs/heads/main*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git restore .)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git branch -D main)",
      "Bash(git config --global*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Bash(rm -Rf*)",
      "Bash(rm -r -f*)",
      "Bash(sudo *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(npm publish*)",
      "Bash(gh repo delete*)",
      "Bash(gh secret*)",
      "Bash(eas secret*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./supabase/.env)",
      "Read(./supabase/.env.*)",
      "Read(~/.ssh/**)",
      "Bash(* .env)",
      "Bash(* .env.local)",
      "Bash(* .env.*.local)",
      "Bash(* */.env)",
      "Bash(* */.env.local)",
      "Bash(* supabase/.env*)",
      "Bash(bat *.env)",
      "Bash(bat *.env.local)",
      "Bash(rg *.env)",
      "Bash(rg *.env.local)",
      "Bash(cat *.env)",
      "Bash(cat *.env.local)",
      "Bash(less *.env)",
      "Bash(less *.env.local)",
      "Bash(head *.env)",
      "Bash(head *.env.local)",
      "Bash(tail *.env)",
      "Bash(tail *.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-ai-attribution.sh"
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["engram"],
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "expo@expo-plugins": true
  },
  "extraKnownMarketplaces": {
    "expo-plugins": {
      "source": {
        "source": "github",
        "repo": "expo/skills"
      }
    }
  }
}
